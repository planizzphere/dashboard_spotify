              {
                "textRuns": [
                  {
                    "value": "What the data says",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "15pt",
                      "color": "#ffffff"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Full catalog · 89,741 tracks",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#b3b3b3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#b3b3b3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Zero popularity is a coverage gap, not a verdict. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#ffffff"
                    }
                  },
                  {
                    "value": "10.5% of tracks score 0, concentrated in Jazz (68%), Iranian (66%), Romance and Soul (61%). Excluding them moves Dance from a median of 1 to 69, the highest of any genre.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#b3b3b3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#b3b3b3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. No single audio feature explains popularity. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#ffffff"
                    }
                  },
                  {
                    "value": "Instrumentalness is the strongest linear signal (r = −0.19, r² ≈ 4%). The other five features stay below |r| = 0.09.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#b3b3b3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#b3b3b3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Hits are vocal and produced. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#ffffff"
                    }
                  },
                  {
                    "value": "The top 10% (popularity ≥ 61) is 59% less instrumental and 17% less acoustic than the catalog, and 6% more danceable.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#b3b3b3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#b3b3b3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Collaboration pays. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#ffffff"
                    }
                  },
                  {
                    "value": "Collaborations reach a median popularity of 41 vs. 36 for solo tracks; explicit tracks 41 vs. 37.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#b3b3b3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#b3b3b3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "5. Length has a sweet spot. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#ffffff"
                    }
                  },
                  {
                    "value": "3–4 minute tracks hold the highest median (40); tracks under 2 or over 7 minutes drop to 27.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#b3b3b3"
