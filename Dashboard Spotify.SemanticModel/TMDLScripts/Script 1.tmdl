	table medidas
		lineageTag: 6581bde3-8e8e-4037-aba8-fb7b16d4ad0a

		measure average_duration_mmss = ```
				
				VAR TotalSegundos = 
				    DIVIDE(AVERAGE(DimTrack[duration_ms]), 1000)
				VAR Minutos = 
				    INT(TotalSegundos / 60)
				VAR Segundos = 
				    MOD(TotalSegundos, 60)
				RETURN
				    FORMAT(Minutos, "00") & ":" & FORMAT(Segundos, "00")
				```
			lineageTag: f46c27f5-0de7-4ad4-a5fb-16e4880d6cca

		measure average_tempo =
				
				FORMAT(AVERAGE(Fact_Track[tempo]), "0.0") & " BPM"
