	/// Adjusted median popularity in context minus the adjusted median of the full catalog.
	measure dif_vs_catalog =
			-- benchmark against the whole catalog
			[adjusted_popularity] - CALCULATE( [adjusted_popularity], REMOVEFILTERS() )
		formatString: +0;-0;0
