table medidas
	lineageTag: 6581bde3-8e8e-4037-aba8-fb7b16d4ad0a

	/// Average track duration as mm:ss. Seconds are rounded before splitting, so the result can never show ":60".
	measure average_duration_mmss =
			VAR _AvgMs = AVERAGE( DimTrack[duration_ms] )
			VAR _TotalSeconds = ROUND( DIVIDE( _AvgMs, 1000 ), 0 )
			VAR _Minutes = INT( _TotalSeconds / 60 )
			VAR _Seconds = _TotalSeconds - _Minutes * 60
			RETURN
			    IF(
			        NOT( ISBLANK( _AvgMs ) ),
			        FORMAT( _Minutes, "00" ) & ":" & FORMAT( _Seconds, "00" )
			    )
		displayFolder: Duración y Tempo
		lineageTag: f46c27f5-0de7-4ad4-a5fb-16e4880d6cca

	/// Average tempo formatted as text (e.g. "122.1 BPM").
	measure average_tempo = FORMAT( AVERAGE( Fact_Track[tempo] ), "0.0" ) & " BPM"
		displayFolder: Duración y Tempo
		lineageTag: 5459aa95-501d-44be-bc7d-461aec32f9e3

