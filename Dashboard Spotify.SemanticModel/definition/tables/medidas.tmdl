	/// HTML glossary of the six audio features (HTML Content visual).
	measure HTML_about =
			
			"
			
			<style>
			  .audio-features {
			    font-family: Arial, sans-serif;
			    color: #FFFFFF;
			    line-height: 1.5;
			
			    /* Dos columnas */
			    display: grid;
			    grid-template-columns: 1fr 1fr;
			    column-gap: 40px;
			    row-gap: 18px;
			
			    /* Centrado vertical y horizontal */
			    align-content: center;
			    justify-content: center;
			    align-items: center;
			
			    text-align: center;
			
			    /* Ocupa toda la altura disponible */
			    height: 100%;
			    box-sizing: border-box;
			  }
			
			  .feature {
			    margin-bottom: 0;
			  }
			
			  .feature strong {
			    display: block;
			    color: #FFFFFF;
			    font-size: 15px;
			    font-weight: 600;
			    margin-bottom: 4px;
			  }
			
			  .feature span {
			    display: block;
			    color: #FFFFFF;
			    font-size: 12px;
			    font-weight: 400;
			    opacity: 0.85;
			  }
			</style>
			
			<div class=""audio-features"">
			
			  <div class=""feature"">
			    <strong>Energy</strong>
			    <span>Measures the perceived intensity and activity of a track.</span>
			  </div>
			
			  <div class=""feature"">
			    <strong>Danceability</strong>
			    <span>Indicates how suitable a track is for dancing.</span>
			  </div>
			
			  <div class=""feature"">
			    <strong>Valence</strong>
			    <span>Represents the musical positiveness of a track, ranging from 0.0 (sad) to 1.0 (happy).</span>
			  </div>
			
			  <div class=""feature"">
			    <strong>Acousticness</strong>
			    <span>Indicates the confidence that a track is acoustic.</span>
			  </div>
			
			  <div class=""feature"">
			    <strong>Instrumentalness</strong>
			    <span>Predicts whether a track contains vocals; values closer to 1.0 indicate instrumental music.</span>
			  </div>
			
			  <div class=""feature"">
			    <strong>Speechiness</strong>
			    <span>Measures the presence of spoken words in a track.</span>
			  </div>
			
			</div>
			"
		displayFolder: Textos y Etiquetas
		lineageTag: 9d986cb4-bf2d-4333-b090-773f09093e6c

