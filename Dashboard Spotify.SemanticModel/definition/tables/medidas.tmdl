	/// Share of tracks without any data-quality flag.
	measure '% Registros Limpios' =
			IF(
			    NOT( ISBLANK( [Total Tracks] ) ),
			    1 - DIVIDE( [tracks_with_issues], [Total Tracks] )
			)
		formatString: 0.0%
		displayFolder: Calidad de Datos
