	/// Selected feature in context divided by the full-catalog average (1.00 = catalog). The feature filter is re-applied after REMOVEFILTERS so the denominator matches the row feature.
	measure feature_index =
			VAR _Feature = [_selected_feature]
			VAR _Catalog =
			    CALCULATE(
			        [audio_feature_value],
			        REMOVEFILTERS(),
			        TREATAS( { _Feature }, 'Audio Features'[Feature] )
			    )
			RETURN
			    DIVIDE( [audio_feature_value], _Catalog )
		formatString: 0.00
		displayFolder: Audio Features\Parametrizadas
		lineageTag: 84c2c482-e9b0-4dc1-a281-12f80f583ed9

	/// Population standard deviation of the selected feature.
	measure feature_dispersion =
			SWITCH(
			    [_selected_feature],
			        "Danceability", STDEV.P( Fact_Track[danceability] ),
			        "Energy", STDEV.P( Fact_Track[energy] ),
			        "Valence", STDEV.P( Fact_Track[valence] ),
			        "Acousticness", STDEV.P( Fact_Track[acousticness] ),
			        "Instrumentalness", STDEV.P( Fact_Track[instrumentalness] ),
			        "Speechiness", STDEV.P( Fact_Track[speechiness] )
			)
		formatString: 0.000
		displayFolder: Audio Features\Parametrizadas
		lineageTag: f9317188-2918-4ddf-a3f3-aefe67d122d1

	/// Pearson correlation between the selected feature and popularity, computed track by track over tracks with popularity > 0 (two-pass formula for numerical stability). Blank when fewer than 30 tracks.
	measure feature_vs_popularity =
			VAR _Feature = [_selected_feature]
			VAR _Base =
			    SELECTCOLUMNS(
			        FILTER( Fact_Track, Fact_Track[popularity] > 0 ),
			        "@x",
			            SWITCH(
			                _Feature,
			                "Danceability", Fact_Track[danceability],
			                "Energy", Fact_Track[energy],
			                "Valence", Fact_Track[valence],
			                "Acousticness", Fact_Track[acousticness],
			                "Instrumentalness", Fact_Track[instrumentalness],
			                "Speechiness", Fact_Track[speechiness]
			            ),
			        "@y", Fact_Track[popularity]
			    )
			VAR _N = COUNTROWS( _Base )
			VAR _MeanX = AVERAGEX( _Base, [@x] )
			VAR _MeanY = AVERAGEX( _Base, [@y] )
			VAR _Cov = SUMX( _Base, ( [@x] - _MeanX ) * ( [@y] - _MeanY ) )
			VAR _SSX = SUMX( _Base, ( [@x] - _MeanX ) ^ 2 )
			VAR _SSY = SUMX( _Base, ( [@y] - _MeanY ) ^ 2 )
			RETURN
			    IF( _N >= 30, DIVIDE( _Cov, SQRT( _SSX * _SSY ) ) )
		formatString: +0.000;-0.000;0.000
		displayFolder: Audio Features\Parametrizadas
		lineageTag: 58c757b3-e395-41e7-ba64-fd54b8e74d5a

	/// Share of explicit tracks.
	measure %_explicit =
			DIVIDE(
			    CALCULATE( [Total Tracks], KEEPFILTERS( DimTrack[explicit] = TRUE() ) ),
			    [Total Tracks]
			)
		formatString: 0.0%
		displayFolder: Composición y Colaboraciones
		lineageTag: a0c83026-192e-4a1a-b9e7-965586eb9dcd

	/// Average number of credited artists per track. The artist filter is removed for the count so selecting one artist still counts that artist's co-credits.
	measure artists_per_track =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS( Bridge_TrackArtist ),
			        REMOVEFILTERS( DimArtist ),
			        VALUES( DimTrack[track_id] )
			    ),
			    [Total Tracks]
			)
		formatString: 0.00
		displayFolder: Composición y Colaboraciones
		lineageTag: 8386d407-8e74-40cc-bc40-e0cd9aba8079

	/// Share of tracks credited to more than one artist (uses DimTrack[collab_type], so it stays correct when an artist is selected).
	measure %_collabs =
			DIVIDE(
			    CALCULATE( [Total Tracks], KEEPFILTERS( DimTrack[collab_type] = "Collaboration" ) ),
			    [Total Tracks]
			)
		formatString: 0.0%
		displayFolder: Composición y Colaboraciones
		lineageTag: bb1696ed-de7a-4730-b570-2e5bbbe45527

	/// Share of tracks listed under more than one genre. The genre filter is removed inside the per-track count so selecting a genre does not force the result to 0%.
	measure %_multi_genre_tracks =
			VAR _Multi =
			    COUNTROWS(
			        FILTER(
			            VALUES( DimTrack[track_id] ),
			            CALCULATE( COUNTROWS( Bridge_TrackGenre ), REMOVEFILTERS( DimGenre ) ) > 1
			        )
			    )
			RETURN
			    DIVIDE( _Multi, [Total Tracks] )
		formatString: 0.0%
		displayFolder: Composición y Colaboraciones
		lineageTag: e0bf491c-ec78-4ae4-8870-4ee962056f17

	/// Tracks with tempo = 0 (failed tempo detection).
	measure no_valid_tempo_tracks = CALCULATE( [Total Tracks], KEEPFILTERS( Fact_Track[tempo] = 0 ) ) + 0
		formatString: #,0
		displayFolder: Calidad de Datos
		lineageTag: 49746222-eaa8-424f-b648-7147c92a1d47

	/// Tracks shorter than 30 seconds or longer than 10 minutes.
	measure tracks_out_of_range =
			CALCULATE(
			    [Total Tracks],
			    KEEPFILTERS(
			        DimTrack[duration_ms] < 30000
			            || DimTrack[duration_ms] > 600000
			    )
			) + 0
		formatString: #,0
